# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter / notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test / coverage outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Data outputs (keep source data tracked, ignore generated outputs)
*.parquet
*.csv
!data/*.csv
!data/*.json

# Logs
*.log

# Environment files
.env
.env.*
